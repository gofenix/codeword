# Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/

# Applications commit their lockfile so builds are reproducible across
# developers and CI. Package libraries intentionally do NOT commit the
# lockfile so downstream consumers can resolve independently.
packages/*/pubspec.lock

# IDE
.idea/
.vscode/
*.iml
.DS_Store

# macOS (shared between apps and packages)
**/macos/Pods/
**/macos/.symlinks/
**/macos/Flutter/ephemeral/
**/macos/Flutter/Generated.xcconfig
**/macos/**/xcuserdata/

# iOS (shared between apps and packages)
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/ephemeral/
**/ios/Flutter/Generated.xcconfig
**/ios/**/xcuserdata/

# Android
apps/*/android/.gradle/
apps/*/android/local.properties
apps/*/android/app/release/
apps/*/android/.idea/
apps/*/android/key.properties
apps/*/*.jks

# Coverage
coverage/

# Generated
**/generated_plugin_registrant.*
**/*.g.dart
**/*.freezed.dart

# Release artifacts (built fresh per release, not source)
*.dmg
*.app
*.apk
*.ipa
release/

# Python tooling (used by the qwerty import script)
__pycache__/
*.pyc
*.pyo

# Qwerty-learner source — cloned at conversion time by tools/import_qwerty_dict.py
tools/_qwerty_src/**

# Local assets with credentials / bundled secrets — never commit.
# A .gitkeep placeholder should live alongside the asset folder so it
# exists on a fresh clone (rootBundle requires the folder to exist).
apps/*/assets/local/**
!apps/*/assets/local/.gitkeep
